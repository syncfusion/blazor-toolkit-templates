<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<PackageId>Syncfusion.Blazor.Toolkit.Templates</PackageId>
		<Version>2.0.0</Version>
		<PackageVersion>2.0.0</PackageVersion>
		<Title>Blazor Toolkit Templates</Title>
		<Company>Syncfusion (scaffold)</Company>
		<Authors>Syncfusion Team</Authors>
		<Description>Scaffolded templates for the Blazor Toolkit repository (scaffolded from user request).</Description>
		<PackageTags>Blazor, Templates, Syncfusion, Toolkit</PackageTags>
		<RepositoryUrl>https://github.com/syncfusion/blazor-toolkit-templates</RepositoryUrl>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>syncfusion_logo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<!-- REQUIRED for templates -->
		<IsPackable>true</IsPackable>
		<PackageType>Template</PackageType>
		<TargetFramework>net10.0</TargetFramework>
		<IncludeContentInPack>true</IncludeContentInPack>
		<ContentTargetFolders>content</ContentTargetFolders>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<NoBuild>true</NoBuild>
		<NoDefaultExcludes>true</NoDefaultExcludes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.TemplateEngine.Tasks" Version="*" PrivateAssets="all" IsImplicitlyDefined="true" />
	</ItemGroup>

	<ItemGroup>
		<!-- Pack template files ONLY (not projects) -->
		<Content Include="blazor-toolkit-web/**/*"
				Exclude="**/bin/**;**/obj/**;**/.vs/**;**/*.user;**/*.csproj.user"
				Pack="true" />

		<Content Include="blazor-toolkit-wasm/**/*"
				Exclude="**/bin/**;**/obj/**;**/.vs/**;**/*.user;**/*.csproj.user"
				Pack="true" />

		<Compile Remove="**\*" />
		<EmbeddedResource Remove="**\*" />
		<None Remove="**\*" />

		<None Include="..\LICENSE.txt" Pack="true" PackagePath="LICENSE.txt" />
    	<None Include="syncfusion_logo.png" Pack="true" PackagePath="syncfusion_logo.png" />
    	<None Include="..\README.md" Pack="true" PackagePath="README.md" />
	</ItemGroup>
</Project>
