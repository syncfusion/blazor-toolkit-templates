<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Blazor.Toolkit.Template</RootNamespace>
    <AssemblyName>Blazor.Toolkit.Template</AssemblyName>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Syncfusion.Blazor.Toolkit" Version="1.0.*" />
    <!-- Keep SfCard: commercial Cards package -->
    <PackageReference Include="Syncfusion.Blazor.Cards" Version="*" />
    <PackageReference Include="Syncfusion.Blazor.Themes" Version="*" />
  </ItemGroup>

  <!--#if (UseWebAssembly) -->
  <ItemGroup>
    <ProjectReference Include="..\Blazor.Toolkit.Template.Client\Blazor.Toolkit.Template.Client.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.5" />
  </ItemGroup>
  <!--#endif -->
</Project>