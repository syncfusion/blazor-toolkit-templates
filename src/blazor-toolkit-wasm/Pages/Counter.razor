@page "/counter"
@using Syncfusion.Blazor.Toolkit

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<div class="mb-3">
    <label class="form-label">Current count</label>
    <SfNumericTextBox TValue="int" @bind-Value="currentCount" Enabled="false" CssClass="w-25" />
    <span class="ms-2 text-muted">(updated on button clicks)</span>
</div>

<div class="d-flex gap-2">
    <SfButton CssClass="e-outline" OnClick="Decrement">-</SfButton>
    <SfButton CssClass="e-primary" OnClick="IncrementCount">Increment</SfButton>
    <SfButton CssClass="e-danger" OnClick="ResetCount">Reset</SfButton>
</div>

@code {
    private int currentCount = 0;

    private void IncrementCount(Microsoft.AspNetCore.Components.Web.MouseEventArgs _)
    {
        currentCount++;
    }

    private void Decrement(Microsoft.AspNetCore.Components.Web.MouseEventArgs _)
    {
        if (currentCount > 0) currentCount--;
    }

    private void ResetCount(Microsoft.AspNetCore.Components.Web.MouseEventArgs _)
    {
        currentCount = 0;
    }
}

